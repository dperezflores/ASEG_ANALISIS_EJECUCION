# Configuración de IA
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"

# Base de datos Neon. No suba este valor real al repositorio.
DATABASE_URL = "postgresql://usuario:password@host/neondb?sslmode=require"

# Autenticación OIDC con Google.
# En despliegue, redirect_uri debe usar la URL pública exacta de la app
# terminada en /oauth2callback.
[auth]
redirect_uri = "https://SU-APP.streamlit.app/oauth2callback"
cookie_secret = "GENERE_UN_SECRETO_ALEATORIO_LARGO"
client_id = "CLIENT_ID_DE_GOOGLE"
client_secret = "CLIENT_SECRET_DE_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
